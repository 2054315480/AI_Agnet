# =============================================================
# Docker Compose 环境变量配置
# 复制为 .env 并修改实际值:
#   cp .env.example .env
#
# 注意：API Key 仅限本次大赛使用，请勿挪作他用
# =============================================================

# PostgreSQL
POSTGRES_DB=Love_Agent
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_PORT=5432

# AI 网关 (aigw.asiainfo.com)
# 可用模型: aliyun/qwen3.6-plus, aliyun/deepseek-v3.2, aliyun/glm-5, aliyun/kimi-k2.5, aliyun/MiniMax-M2.5
AI_API_KEY=PUT_YOUR_DASHSCOPE_API_KEY_HERE
AI_BASE_URL=https://aigw.asiainfo.com

# JWT 密钥 (至少 32 字符，生产环境务必修改)
JWT_SECRET=change-me-in-production-use-at-least-32-chars

# 前端端口
FRONTEND_PORT=80
